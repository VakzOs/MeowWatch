# Copier en .env (chmod 600). Sur le VPS : BIND_IP=172.17.0.1 (cloudflared tourne en conteneur).
BIND_IP=172.17.0.1
PUBLIC_URL=https://meowwatch.vkzdev.com
# Application Discord (https://discord.com/developers/applications), onglet OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Ton identifiant Discord (Paramètres > Avancés > Mode développeur, puis clic droit sur ton nom > Copier l'identifiant).
OWNER_DISCORD_ID=
